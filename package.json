{
  "name": "@openstellar/tool-search",
  "version": "1.0.0",
  "description": "Tool search plugin for OpenCode — BM25 and regex search to discover tools on demand, reducing context usage",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL_PROMPT.md"
  ],
  "scripts": {
    "build": "tsc && rollup -c rollup.dts.config.mjs && node esbuild.config.mjs && rm -rf dist/src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/benchmark-thesis.mjs",
    "bench:ci": "node scripts/benchmark-thesis.mjs --ci",
    "prepublishOnly": "npm run build",
    "smoke:plugin": "node scripts/smoke-plugin-load.mjs"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tool-search",
    "bm25",
    "context-reduction",
    "deferred-loading"
  ],
  "author": "OpenStellar",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-stl/openstellar-tool-search.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.17.2",
    "effect": "^4.0.0-beta.74"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.2",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.0",
    "rollup": "^4.61.1",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "semver": "^7.8.5"
  }
}
